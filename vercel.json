{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/catalog.js": { "maxDuration": 300 },
    "api/installments.js": { "maxDuration": 20 },
    "api/shopify-status.js": { "maxDuration": 30 },
    "api/draft-request.js": { "maxDuration": 120 }
  },
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
